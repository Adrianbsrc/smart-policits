{
  "name": "@smart-politics/etl",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "sync:camara":         "tsx scripts/sync-camara.ts",
    "sync:senado":         "tsx scripts/sync-senado.ts",
    "sync:governors":      "tsx scripts/sync-governors.ts",
    "sync:presidents":     "tsx scripts/sync-presidents.ts",
    "sync:curated-scores": "tsx scripts/sync-curated-scores.ts",
    "sync:tse-bens":       "tsx scripts/sync-tse-bens.ts",
    "sync:cnj-integrity":  "tsx scripts/sync-cnj-integrity.ts",
    "sync:all":            "tsx scripts/sync-all.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@smart-politics/db": "workspace:*",
    "@smart-politics/scoring": "workspace:*",
    "@smart-politics/types": "workspace:*",
    "dotenv": "^16.0.0",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
